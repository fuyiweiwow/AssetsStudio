      "prompt_contract": {
        "positive": [
          "moderate compact chibi proportions around 2.1 to 2.5 heads tall",
          "polished soft 3D Japanese-anime game figurine",
          "smooth rounded low-frequency geometry and thick readable silhouettes",
          "clean matte material colors, soft studio light, subtle ambient occlusion",
          "western fantasy adventurer design language"
        ],
        "negative": [
          "realistic adult proportions or long slender limbs",
          "extreme one-and-a-half-head super deformed proportions",
          "photoreal skin, painterly brushwork, noisy micro-texture",
          "thin fragile straps, excessive ornaments, sharp high-frequency detail",
          "perspective distortion, action pose, dramatic lighting"
        ],
        "immutable_traits": [
          "rounded moderate-chibi silhouette",
          "soft 3D anime figurine material response",
          "low-frequency readable geometry",
          "shared semantic palette roles"
        ]
      },
      "qa": {
        "required_views": [
          "front",
          "right",
          "back",
          "left"
        ],
        "checks": [
          "target total-head range",
          "silhouette readability at thumbnail size",
          "semantic palette continuity",
          "same material response across character and accessory",
          "no realism or detail-density drift"
        ],
        "human_review_required": true
      }
