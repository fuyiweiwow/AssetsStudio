        "silhouette": "moderate compact chibi; large rounded head, short sturdy limbs, small torso and readable hands/feet"
      },
      "shape_language": [
        "large simple rounded masses",
        "low-frequency silhouette before surface detail",
        "soft bevels and thick readable accessory shapes",
        "oversized expressive eyes with compact facial spacing",
        "avoid thin fragile straps and realistic micro-detail"
      ],
      "render_language": {
        "medium": "polished soft 3D Japanese-anime game figurine",
        "surface": "clean matte colors with restrained roughness variation",
        "lighting": "soft studio key and fill with subtle ambient occlusion",
        "linework": "no heavy outline; shape separation comes from value and occlusion",
        "detail_density": "low to medium; every detail must remain readable at game camera distance"
      },
