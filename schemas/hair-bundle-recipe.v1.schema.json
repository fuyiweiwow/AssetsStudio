{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetsstudio.local/schemas/hair-bundle-recipe.v1.schema.json",
  "title": "AssetsStudio hair bundle recipe v1",
  "type": "object",
  "required": ["schema", "id", "status", "gender", "source_blend", "actor_blend", "source_anchor_object", "components", "fit", "material", "binding", "cache"],
  "properties": {
    "schema": { "const": "assetsstudio_hair_bundle_recipe_v1" },
    "id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["provisional", "accepted", "rejected"] },
    "gender": { "enum": ["female", "male", "neutral"] },
    "source_blend": { "type": "string", "minLength": 1 },
    "actor_blend": { "type": "string", "minLength": 1 },
    "source_anchor_object": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "fit": {
      "type": "object",
      "required": ["normalize_source_component_layout", "q_height_ratio", "width_ratio"],
      "properties": {
        "normalize_source_component_layout": { "type": "boolean" },
        "q_height_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "width_ratio": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": ["rgba"],
      "properties": {
        "rgba": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["bone", "web_contract"],
      "properties": {
        "bone": { "type": "string", "minLength": 1 },
        "web_contract": { "const": "single_bone_skin" }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "required": ["directory", "blend", "thumbnail"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "blend": { "type": "string", "minLength": 1 },
        "thumbnail": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "known_issue": { "type": "string" }
  },
  "additionalProperties": false
}
