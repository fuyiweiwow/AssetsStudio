{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetsstudio.local/schemas/recipe.v1.schema.json",
  "title": "AssetsStudio humanoid recipe v1 placeholder",
  "type": "object",
  "required": ["schema", "seed", "components"],
  "properties": {
    "schema": { "const": "assetsstudio_humanoid_recipe_v1" },
    "seed": { "type": "integer" },
    "components": {
      "type": "object",
      "properties": {
        "hair": { "type": ["string", "null"] },
        "face": { "type": ["string", "null"] },
        "top": { "type": ["string", "null"] },
        "pants": { "type": ["string", "null"] },
        "shoes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
