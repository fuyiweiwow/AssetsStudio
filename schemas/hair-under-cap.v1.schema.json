{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetsstudio.local/schemas/hair-under-cap.v1.schema.json",
  "title": "AssetsStudio hair under-cap candidate v1",
  "type": "object",
  "required": ["schema", "status", "actor_blend", "object", "profile", "binding", "geometry", "renders"],
  "properties": {
    "schema": { "const": "assetsstudio_hair_under_cap_v1" },
    "status": { "enum": ["candidate", "reviewed", "accepted", "rejected"] },
    "actor_blend": { "type": "string", "minLength": 1 },
    "object": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["rear_side_top", "full_upper_head", "seed04_scalp_base"] },
    "variant": { "enum": ["conservative", "coverage"] },
    "binding": {
      "type": "object",
      "required": ["bone", "web_contract"],
      "properties": {
        "bone": { "const": "CC_Base_Head" },
        "web_contract": { "const": "single_bone_skin" }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": ["vertices", "polygons", "surface_offset", "selected_faces"],
      "properties": {
        "vertices": { "type": "integer", "minimum": 1 },
        "polygons": { "type": "integer", "minimum": 1 },
        "surface_offset": { "type": "number", "exclusiveMinimum": 0 },
        "selected_faces": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "renders": {
      "type": "object",
      "required": ["front", "right", "back", "left"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
