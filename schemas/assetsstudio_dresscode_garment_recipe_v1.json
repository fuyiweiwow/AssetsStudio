{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetsstudio.local/schemas/assetsstudio_dresscode_garment_recipe_v1.json",
  "title": "AssetsStudio DressCode garment recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generator", "seed", "style", "components", "shape", "appearance"],
  "properties": {
    "schema": {"const": "assetsstudio_dresscode_garment_recipe_v1"},
    "generator": {"const": "DressCode"},
    "generator_commit": {"type": "string", "minLength": 7},
    "seed": {"type": "integer", "minimum": 0},
    "style": {"type": "string", "minLength": 1},
    "prompt": {"type": "string"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["robe_body", "sleeves", "hood", "collar", "belt", "trim"]
      },
      "uniqueItems": true
    },
    "shape": {"$ref": "#/$defs/shape"},
    "appearance": {"$ref": "#/$defs/appearance"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_id": {"type": "string"},
        "pattern_source": {"type": "string"},
        "material_source": {"type": "string"}
      }
    }
  },
  "$defs": {
    "normalized": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robe_length", "ease", "sleeve_length", "sleeve_width", "hood_height", "hood_depth", "collar_opening", "front_closure", "hem_slit"],
      "properties": {
        "robe_length": {"$ref": "#/$defs/normalized"},
        "ease": {"$ref": "#/$defs/normalized"},
        "sleeve_length": {"$ref": "#/$defs/normalized"},
        "sleeve_width": {"$ref": "#/$defs/normalized"},
        "hood_height": {"$ref": "#/$defs/normalized"},
        "hood_depth": {"$ref": "#/$defs/normalized"},
        "collar_opening": {"$ref": "#/$defs/normalized"},
        "front_closure": {"type": "string", "enum": ["center", "left_overlap", "right_overlap", "open"]},
        "hem_slit": {"$ref": "#/$defs/normalized"}
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_color", "secondary_color", "trim_color", "material", "pattern_strength"],
      "properties": {
        "primary_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "secondary_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "trim_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "material": {"type": "string", "minLength": 1},
        "pattern_strength": {"$ref": "#/$defs/normalized"}
      }
    }
  }
}
