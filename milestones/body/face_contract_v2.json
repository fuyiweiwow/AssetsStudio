    "random_scheduler": false
  },
  "eye_textures": {
    "open_left": "milestones/body/eye_textures/eye_left.png",
    "open_right": "milestones/body/eye_textures/eye_right.png",
    "half_left": "milestones/body/eye_textures/eye_half_left.png",
    "half_right": "milestones/body/eye_textures/eye_half_right.png",
    "closed_left": "milestones/body/eye_textures/eye_closed_left.png",
    "closed_right": "milestones/body/eye_textures/eye_closed_right.png",
    "packed_into_actor_face_blend": true
  },
  "placement": {
    "parent": "Armature/CC_Base_Head",
    "fit_modifier": "EyeAssemblyV1_FitToHeadSurface",
    "side_policy": "same_3d_assembly_projection",
    "back_policy": "transparent_no_eye_geometry"
  },
  "ear_source": {
    "file": "references/face/miku_chibi_source/miku_chibi_source.fbx",
    "source_mesh": "head_org_0_0_node",
    "policy": "source_only_do_not_load_in_runtime"
  },
  "actor_3to2_pipeline": {
    "render": "tools/blender/render_accurig_chibi_walk_test.py",
    "pixel_process": "tools/process_actor_3to2_pixels.py",
    "validate": "tools/validate_actor_3to2_pixels.py",
    "directions": ["front", "right", "back", "left"],
    "default_frames": 8
  },
  "rebuild": "tools/build_actor_eye_assembly.ps1",
  "review": "tools/render_actor_eye_blink_review.ps1",
  "validate": "tools/blender/validate_actor_eye_assembly.py"
