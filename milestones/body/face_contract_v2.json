{
  "schema": "assetsstudio_actor_face_contract_v2",
  "status": "technical_baseline",
  "source_actor_blend": "milestones/body/chibi_actor_mixamo_walk_v1.blend",
  "actor_face_blend": "milestones/body/chibi_actor_eye_assembly_v2.blend",
  "head_bone": "CC_Base_Head",
  "embedded_objects": {
    "eyes": [
      "EyeAssemblyV1_Front_L",
      "EyeAssemblyV1_Front_R"
    ],
    "ears": [
      "MikuEar_L_SourceV1",
      "MikuEar_R_SourceV1"
    ]
  },
  "blink": {
    "states": ["open", "half", "closed"],
    "schedule": ["open", "half", "closed", "half", "open", "open", "open", "open"],
